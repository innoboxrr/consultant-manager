{
    "name": "innoboxrr/consultant-manager",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\ConsultantManager\\": "src/",
            "Innoboxrr\\ConsultantManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^9.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\ConsultantManager\\Providers\\AppServiceProvider",
                "Innoboxrr\\ConsultantManager\\Providers\\AuthServiceProvider",
                "Innoboxrr\\ConsultantManager\\Providers\\EventServiceProvider",
                "Innoboxrr\\ConsultantManager\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\ConsultantManager\\Tests\\": "tests/"
        }
    },
    "require": {
        "innoboxrr/traits": "^2.1",
        "innoboxrr/laravel-audit": "^2.0",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Necesario para las exportaciones del paquete (^3.1)."
    },
    "description": "Gestion de consultorias en Laravel: consultores y su disponibilidad, equipos, citas, asesorias, plantillas de expediente y chats de consulta."
}
